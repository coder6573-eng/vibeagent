# Vibe Agent configuration (all optional)
#
# By default the agent talks to the Kilo AI Gateway anonymously and uses the
# free auto-routing model. No key is required.

# Model id. Try kilo-auto/free, kilo-auto/efficient or any model from
# `vibe models`.
VIBE_MODEL=kilo-auto/free

# OpenAI-compatible base URL.
VIBE_BASE_URL=https://ai-gateway.kilo.ai/api/v1

# Optional API key. Anonymous access works for free models (200 req/hour per IP).
# VIBE_API_KEY=

# Routing hint sent as `x-kilocode-mode` for kilo-auto models.
# One of: build, plan, architect, debug, ask, code, explore
VIBE_MODE=build

# Skip approval prompts for file writes and shell commands. Use with care.
# VIBE_YOLO=1
